# Copie para .env.local e ajuste conforme o ambiente.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Sem DATABASE_URL o sistema usa um PostgreSQL embarcado (PGlite), persistido em
# disco em PGLITE_DATA_DIR. Ideal para uso local ou servidor próprio (1 instância).
# PGLITE_DATA_DIR=.data/pglite

# Com DATABASE_URL o sistema usa PostgreSQL externo (Supabase, Neon, RDS, local...).
# Supabase: Project Settings → Database → Connection string.
#   - Session pooler (porta 5432): funciona sem ajustes.
#   - Transaction pooler (porta 6543): mantenha DATABASE_PREPARE=false (padrão).
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DATABASE_POOL_MAX=10
# DATABASE_PREPARE=false

# Aplica as migrações automaticamente ao iniciar (com DATABASE_URL).
# Recomendado: deixar false e rodar `npm run db:migrate` no deploy.
# DB_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
# Em produção os cookies de sessão são "Secure" (exigem HTTPS; localhost é aceito).
# Use true SOMENTE se precisar servir por HTTP em rede interna.
# INSECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Mercado ao vivo (página /mercado) — tudo opcional
# ---------------------------------------------------------------------------
# Sem nenhuma chave a página já mostra: ações PETR4/VALE3/ITUB4/MGLU3 (brapi),
# dólar e euro PTAX e Selic (Banco Central), câmbio de referência do BCE,
# 10 criptomoedas (CoinGecko) e notícias de feeds públicos.
#
# Ibovespa: token gratuito em https://brapi.dev (o índice exige token).
# BRAPI_TOKEN=
#
# "Por que o mercado se moveu?" com IA (Claude). Chave em https://console.anthropic.com
# Cada explicação custa alguns centavos de dólar; o servidor guarda a resposta por 10 min.
# ANTHROPIC_API_KEY=
#
# Chave "Demo" gratuita da CoinGecko (opcional; aumenta o limite de consultas).
# COINGECKO_DEMO_API_KEY=
#
# Testes/uso offline: lê um retrato gravado com `npm run market:snapshot -- arquivo.json`.
# MARKET_FIXTURE_FILE=
