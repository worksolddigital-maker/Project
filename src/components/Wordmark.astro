---
/**
 * Assinatura da marca, no estilo do logotipo usado pela profissional
 * (ESTÉTICA AVANÇADA sobre LETÍCIA em traço fino + ORLANDIN em peso
 * regular, sem serifa). Substitua pelo SVG oficial quando disponível.
 */
interface Props {
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { tone = 'dark', size = 'md', class: className } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${tone}`, `wordmark--${size}`, className]}>
  <span class="wordmark__tag">Estética <span class="wordmark__tag-em">Avançada</span></span>
  <span class="wordmark__name"><span class="wordmark__thin">Letícia</span> <span class="wordmark__bold">Orlandin</span></span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4em;
    line-height: 1;
    color: var(--petrol);
    white-space: nowrap;
    font-family: var(--sans);
    text-transform: uppercase;
  }
  .wordmark--light {
    color: var(--offwhite);
  }
  .wordmark__tag {
    font-weight: 500;
    font-size: 0.5rem;
    letter-spacing: 0.34em;
    opacity: 0.8;
  }
  .wordmark__tag-em {
    font-weight: 300;
  }
  .wordmark__name {
    font-size: 1.12rem;
    letter-spacing: 0.12em;
  }
  .wordmark__thin {
    font-weight: 200;
  }
  .wordmark__bold {
    font-weight: 500;
  }
  .wordmark--sm .wordmark__name {
    font-size: 1rem;
  }
  .wordmark--sm .wordmark__tag {
    font-size: 0.46rem;
  }
  .wordmark--lg .wordmark__name {
    font-size: 1.6rem;
  }
  .wordmark--lg .wordmark__tag {
    font-size: 0.62rem;
  }
</style>
