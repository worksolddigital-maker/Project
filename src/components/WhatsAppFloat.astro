---
import Icon from './Icon.astro';
import { whatsapp } from '../data/site';
---

<a
  class="wa-float"
  href={whatsapp()}
  target="_blank"
  rel="noopener"
  data-wa-float
  aria-label="Agendar avaliação pelo WhatsApp"
>
  <span class="wa-float__label" aria-hidden="true">Agende pelo WhatsApp</span>
  <span class="wa-float__icon"><Icon name="whatsapp" /></span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 800;
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 3.6rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--petrol);
    color: var(--offwhite);
    box-shadow: 0 18px 40px -16px rgba(29, 40, 38, 0.55);
    opacity: 0;
    transform: translateY(1.5rem) scale(0.92);
    pointer-events: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.7s var(--ease-out),
      gap 0.6s var(--ease-out);
  }
  :global(html.wa-visible) .wa-float {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  :global(html.menu-open) .wa-float {
    opacity: 0;
    pointer-events: none;
  }
  .wa-float__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.86rem;
    font-weight: 600;
    padding-left: 0;
    transition:
      max-width 0.7s var(--ease-out),
      padding 0.7s var(--ease-out);
  }
  .wa-float__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--mint);
    color: var(--petrol-ink);
  }
  .wa-float__icon :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
  }
  @media (hover: hover) {
    .wa-float:hover .wa-float__label,
    .wa-float:focus-visible .wa-float__label {
      max-width: 14rem;
      padding: 0 0.9rem 0 1.1rem;
    }
  }
</style>
