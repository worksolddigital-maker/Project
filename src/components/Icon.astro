---
/** Ícones em linha fina, desenhados para a identidade (stroke 1.4). */
interface Props {
  name:
    | 'arrow'
    | 'arrow-up-right'
    | 'arrow-down'
    | 'whatsapp'
    | 'instagram'
    | 'pin'
    | 'phone'
    | 'clock'
    | 'plus'
    | 'close'
    | 'route'
    | 'leaf'
    | 'compass'
    | 'sparkle'
    | 'person'
    | 'book'
    | 'detail';
  class?: string;
  size?: number | string;
  title?: string;
}

const { name, class: className, size, title } = Astro.props;
const style = size ? `width:${size};height:${size}` : undefined;
---

<svg
  class={className}
  style={style}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  {name === 'arrow' && <path d="M4 12h15.5M13.5 5.5 20 12l-6.5 6.5" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === 'arrow-down' && <path d="M12 4v15.5M5.5 13.5 12 20l6.5-6.5" />}
  {
    name === 'whatsapp' && (
      <>
        <path d="M20.2 11.6a8.2 8.2 0 0 1-12.1 7.2L3.8 20l1.3-4.1a8.2 8.2 0 1 1 15.1-4.3Z" />
        <path d="M9.1 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .5.6 1 1.4 1.8 2.5 2.3.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .7-.4 1.4-1.1 1.6-.9.3-2.1.1-3.8-.9a8.6 8.6 0 0 1-3-3.1c-.8-1.4-.6-2.6-.1-3.2Z" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="3.9" />
        <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
        <circle cx="12" cy="10" r="2.3" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M8.2 3.8 6.1 4.4c-.9.3-1.6 1.2-1.5 2.2.5 6.6 6.2 12.3 12.8 12.8 1 .1 1.9-.6 2.2-1.5l.6-2.1c.2-.6-.1-1.2-.7-1.5l-2.8-1.3c-.5-.2-1.1-.1-1.5.3l-1.1 1.2a10 10 0 0 1-4.9-4.9l1.2-1.1c.4-.4.5-1 .3-1.5L9.7 4.5c-.3-.6-.9-.9-1.5-.7Z" />
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {
    name === 'route' && (
      <>
        <circle cx="6" cy="18" r="2" />
        <circle cx="18" cy="6" r="2" />
        <path d="M8 18h7.5a3 3 0 0 0 0-6h-7a3 3 0 0 1 0-6H16" />
      </>
    )
  }
  {
    name === 'leaf' && (
      <>
        <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z" />
        <path d="M5 19 13 11" />
      </>
    )
  }
  {
    name === 'compass' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" />
      </>
    )
  }
  {
    name === 'sparkle' && (
      <path d="M12 3.5c.6 4.4 2.6 6.4 7 7-4.4.6-6.4 2.6-7 7-.6-4.4-2.6-6.4-7-7 4.4-.6 6.4-2.6 7-7Z" />
    )
  }
  {
    name === 'person' && (
      <>
        <circle cx="12" cy="8" r="3.5" />
        <path d="M5 20c.8-3.8 3.6-6 7-6s6.2 2.2 7 6" />
      </>
    )
  }
  {
    name === 'book' && (
      <>
        <path d="M4.5 5.5c2.8-.9 5.3-.6 7.5 1v13c-2.2-1.6-4.7-1.9-7.5-1v-13Z" />
        <path d="M19.5 5.5c-2.8-.9-5.3-.6-7.5 1v13c2.2-1.6 4.7-1.9 7.5-1v-13Z" />
      </>
    )
  }
  {
    name === 'detail' && (
      <>
        <circle cx="10.5" cy="10.5" r="6" />
        <path d="m15 15 5 5M10.5 8v5M8 10.5h5" />
      </>
    )
  }
</svg>
