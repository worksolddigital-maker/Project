---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { nav, site, links, whatsapp, fullAddress } from '../data/site';
import { procedures } from '../data/procedimentos';

const year = new Date().getFullYear();
---

<footer class="footer bg-petrol" data-footer>
  <div class="container">
    <div class="footer__top">
      <div class="footer__cta">
        <p class="eyebrow">Agende sua avaliação</p>
        <p class="footer__claim h2">
          Valorizar quem você é<br /><em>começa por uma conversa.</em>
        </p>
        <Button href={whatsapp()} label="Conversar pelo WhatsApp" variant="light" icon="whatsapp" iconFirst size="lg" />
      </div>

      <div class="footer__cols">
        <div class="footer__col">
          <p class="footer__title">Navegação</p>
          <ul role="list">
            {nav.map((item) => <li><a class="footer__link" href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div class="footer__col">
          <p class="footer__title">Procedimentos</p>
          <ul role="list">
            {
              procedures.map((p) => (
                <li>
                  <a class="footer__link" href={`/procedimentos/${p.slug}/`}>{p.name}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="footer__col">
          <p class="footer__title">Contato</p>
          <address class="footer__address">
            <a href={links.maps} target="_blank" rel="noopener" class="footer__link footer__link--icon">
              <Icon name="pin" />
              <span>{fullAddress}</span>
            </a>
            <a href={links.tel} class="footer__link footer__link--icon">
              <Icon name="phone" />
              <span>{site.phone.display}</span>
            </a>
            <a href={site.instagram.url} target="_blank" rel="noopener" class="footer__link footer__link--icon">
              <Icon name="instagram" />
              <span>{site.instagram.handle}</span>
            </a>
          </address>
        </div>
      </div>
    </div>

    <p class="footer__giant" aria-hidden="true" data-footer-giant>
      <span>Letícia</span> <em>Orlandin</em>
    </p>

    <div class="footer__bottom">
      <p>© {year} {site.brand}. Bento Gonçalves/RS.</p>
      <p class="footer__legal">
        As informações deste site têm caráter informativo e não substituem uma avaliação individual.
      </p>
      <a href="#conteudo" class="footer__top-link" data-scroll-top>
        Voltar ao topo
        <span class="footer__top-icon"><Icon name="arrow-down" /></span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(5rem, 4rem + 6vw, 9rem);
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    overflow: hidden;
    background: var(--petrol-deep);
  }
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.4fr);
    gap: clamp(3rem, 6vw, 7rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--line);
  }
  .footer__cta {
    display: grid;
    gap: 1.8rem;
    justify-items: start;
    align-content: start;
  }
  .footer__claim {
    color: var(--offwhite);
  }
  .footer__claim em {
    color: var(--mint);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .footer__title {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mint);
    margin-bottom: 1.3rem;
  }
  .footer__col ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }
  .footer__link {
    font-size: 0.93rem;
    color: rgba(251, 249, 241, 0.78);
    line-height: 1.45;
    transition: color 0.4s var(--ease-out);
  }
  .footer__link:hover {
    color: var(--offwhite);
  }
  .footer__address {
    font-style: normal;
    display: grid;
    gap: 1rem;
  }
  .footer__link--icon {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .footer__link--icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--mint);
  }

  .footer__giant {
    margin: clamp(2rem, 4vw, 4rem) 0 clamp(1rem, 2vw, 2rem);
    font-family: var(--serif);
    font-weight: 330;
    font-size: clamp(4rem, 15.5vw, 16.5rem);
    line-height: 0.85;
    letter-spacing: -0.045em;
    color: rgba(251, 249, 241, 0.92);
    white-space: nowrap;
    text-align: center;
  }
  .footer__giant em {
    color: var(--mint);
    font-weight: 300;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 2.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: rgba(251, 249, 241, 0.6);
  }
  .footer__legal {
    text-align: center;
  }
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--offwhite);
    font-weight: 600;
  }
  .footer__top-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background-color 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .footer__top-icon :global(svg) {
    width: 1rem;
    height: 1rem;
    transform: rotate(180deg);
  }
  .footer__top-link:hover .footer__top-icon {
    background: var(--offwhite);
    color: var(--petrol);
  }

  @media (max-width: 1024px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
    .footer__cols .footer__col:last-child {
      grid-column: 1 / -1;
    }
    .footer__bottom {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .footer__legal {
      text-align: left;
    }
  }
</style>
