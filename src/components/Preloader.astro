---
/**
 * Abertura cinematográfica — exibida uma vez por sessão na página inicial.
 * A entrada é feita em CSS (pinta no primeiro quadro, sem esperar o JS);
 * o GSAP conduz a saída e revela a página.
 */
---

<div class="preloader" aria-hidden="true" data-preloader>
  <div class="preloader__inner" data-preloader-inner>
    <p class="preloader__name" data-preloader-name>
      <span class="preloader__thin">Letícia</span> <span class="preloader__bold">Orlandin</span>
    </p>
    <span class="preloader__line" data-preloader-line></span>
    <p class="preloader__tag" data-preloader-tag>Estética Avançada</p>
  </div>
  <p class="preloader__phrase" data-preloader-phrase>Refinar, não transformar.</p>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9700;
    display: none;
    place-items: center;
    background: var(--offwhite);
    color: var(--petrol);
  }
  :global(html.is-intro) .preloader {
    display: grid;
  }
  .preloader__inner {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
  }
  /* Mesmo desenho do logotipo: LETÍCIA fino + ORLANDIN regular, sem serifa. */
  .preloader__name {
    font-family: var(--sans);
    font-size: clamp(1.7rem, 5.2vw, 4rem);
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    padding-left: 0.14em;
    animation: pre-name 1.3s var(--ease-out) 0.05s both;
  }
  .preloader__thin {
    font-weight: 200;
  }
  .preloader__bold {
    font-weight: 500;
  }
  .preloader__line {
    display: block;
    width: min(16rem, 50vw);
    height: 1px;
    background: var(--petrol);
    transform-origin: center;
    animation: pre-line 1.1s var(--ease-in-out) 0.35s both;
  }
  .preloader__tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    padding-left: 0.5em;
    animation: pre-tag 1.2s var(--ease-out) 0.55s both;
  }
  .preloader__phrase {
    position: absolute;
    left: 50%;
    bottom: max(2.2rem, 5vh);
    transform: translateX(-50%);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    white-space: nowrap;
    animation: pre-fade 1s var(--ease-out) 0.75s both;
  }

  @keyframes pre-name {
    from {
      opacity: 0;
      transform: translateY(0.45em);
      letter-spacing: 0.34em;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      letter-spacing: 0.14em;
      filter: blur(0);
    }
  }
  @keyframes pre-line {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes pre-tag {
    from {
      opacity: 0;
      letter-spacing: 0.85em;
    }
    to {
      opacity: 1;
      letter-spacing: 0.5em;
    }
  }
  @keyframes pre-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
