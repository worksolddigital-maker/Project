---
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { nav, site, whatsapp, links, fullAddress } from '../data/site';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<header class="header" data-header data-tone={tone}>
  <div class="header__bar container">
    <a href="/" class="header__brand" aria-label="Letícia Orlandin Estética Avançada — página inicial" data-intro-hide>
      <Wordmark size="sm" />
    </a>

    <nav class="header__nav" aria-label="Navegação principal" data-intro-hide>
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="header__link" data-nav-link>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions" data-intro-hide>
      <Button
        href={whatsapp()}
        label="Agendar avaliação"
        size="sm"
        icon="whatsapp"
        iconFirst
        class="header__cta"
        data-track="header-whatsapp"
      />
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-toggle
      >
        <span class="header__toggle-label" aria-hidden="true">
          <span>Menu</span>
          <span>Fechar</span>
        </span>
        <span class="sr-only" data-menu-sr>Abrir menu</span>
        <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <div class="header__progress" aria-hidden="true"><span data-progress></span></div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__bg" data-menu-bg></div>
  <div class="menu__inner container" data-lenis-prevent>
    <nav aria-label="Menu">
      <ol class="menu__list" role="list">
        {
          nav.map((item, i) => (
            <li class="menu__item">
              <a href={item.href} class="menu__link" data-menu-link>
                <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__footer" data-menu-footer>
      <p class="menu__address">
        <Icon name="pin" class="menu__icon" />
        <span>{fullAddress}</span>
      </p>
      <div class="menu__contacts">
        <a href={links.tel} class="link">{site.phone.display}</a>
        <a href={site.instagram.url} class="link" target="_blank" rel="noopener">{site.instagram.handle}</a>
      </div>
      <Button href={whatsapp()} label="Agendar pelo WhatsApp" variant="light" icon="whatsapp" iconFirst magnetic={false} />
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    color: var(--petrol);
    transition:
      transform 0.7s var(--ease-out),
      background-color 0.5s var(--ease-out),
      color 0.5s var(--ease-out);
  }
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(251, 249, 241, 0.82);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
    backdrop-filter: saturate(140%) blur(16px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .header[data-tone='light'] {
    color: var(--offwhite);
  }
  .header[data-tone='light'] :global(.wordmark) {
    color: var(--offwhite);
  }
  :global(.header.is-scrolled) {
    color: var(--petrol);
  }
  :global(.header.is-scrolled) :global(.wordmark) {
    color: var(--petrol);
  }
  :global(.header.is-scrolled)::before {
    opacity: 1;
  }
  :global(.header.is-hidden) {
    transform: translateY(-100%);
  }
  :global(html.menu-open) .header {
    transform: none;
    color: var(--offwhite);
  }
  :global(html.menu-open) .header::before {
    opacity: 0;
  }
  :global(html.menu-open) .header :global(.wordmark) {
    color: var(--offwhite);
  }

  .header__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .header__brand {
    position: relative;
    z-index: 2;
    flex: none;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(1.1rem, 1.6vw, 2.1rem);
    margin: 0;
    padding: 0;
  }
  .header__link {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.86;
    transition: opacity 0.4s var(--ease-out);
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out);
  }
  .header__link:hover,
  :global(.header__link.is-active) {
    opacity: 1;
  }
  .header__link:hover::after,
  :global(.header__link.is-active)::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    position: relative;
    z-index: 2;
  }
  :global(html.menu-open) .header__actions :global(.header__cta) {
    opacity: 0;
    pointer-events: none;
  }
  .header__actions :global(.header__cta) {
    transition: opacity 0.4s var(--ease-out);
  }

  .header__toggle {
    display: none;
    align-items: center;
    gap: 0.8rem;
    height: 2.75rem;
    padding: 0 0.35rem 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 0.4s var(--ease-out);
  }
  .header__toggle-label {
    display: inline-grid;
    overflow: hidden;
    line-height: 1.3;
  }
  .header__toggle-label > span {
    grid-area: 1 / 1;
    transition: transform 0.6s var(--ease-out);
  }
  .header__toggle-label > span:last-child {
    transform: translateY(110%);
  }
  .header__toggle[aria-expanded='true'] .header__toggle-label > span:first-child {
    transform: translateY(-110%);
  }
  .header__toggle[aria-expanded='true'] .header__toggle-label > span:last-child {
    transform: none;
  }
  .header__burger {
    position: relative;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: currentColor;
  }
  .header__burger span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.9rem;
    height: 1.4px;
    margin-left: -0.45rem;
    background: var(--offwhite);
    transition: transform 0.6s var(--ease-out);
  }
  :global(html.menu-open) .header__burger span {
    background: var(--petrol);
  }
  .header__burger span:first-child {
    transform: translateY(-3px);
  }
  .header__burger span:last-child {
    transform: translateY(3px);
  }
  .header__toggle[aria-expanded='true'] .header__burger span:first-child {
    transform: rotate(45deg);
  }
  .header__toggle[aria-expanded='true'] .header__burger span:last-child {
    transform: rotate(-45deg);
  }
  :global(html.menu-open) .header__toggle {
    border-color: rgba(251, 249, 241, 0.35);
  }

  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  :global(.header.is-scrolled) .header__progress {
    opacity: 1;
  }
  .header__progress span {
    display: block;
    height: 100%;
    background: var(--petrol);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (max-width: 1180px) {
    .header__nav {
      display: none;
    }
    .header__toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .header__actions :global(.header__cta) {
      display: none;
    }
    .header__bar {
      --header-h: 72px;
    }
  }

  /* ---------- Menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 950;
    color: var(--offwhite);
  }
  .menu__bg {
    position: absolute;
    inset: 0;
    background: var(--petrol);
    clip-path: inset(0 0 100% 0);
  }
  .menu__inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: calc(var(--header-h) + 3vh);
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .menu__list {
    margin: 0;
    padding: 0;
  }
  .menu__item {
    overflow: hidden;
    border-bottom: 1px solid rgba(251, 249, 241, 0.12);
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding: 0.55rem 0;
  }
  .menu__num {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--mint);
    min-width: 1.6rem;
  }
  .menu__label {
    display: inline-block;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 8.5vw, 3.6rem);
    font-weight: 380;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .menu__link:hover .menu__label,
  .menu__link:focus-visible .menu__label {
    font-style: italic;
  }
  .menu__footer {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    font-size: 0.92rem;
    color: rgba(251, 249, 241, 0.82);
  }
  .menu__address {
    display: flex;
    gap: 0.6rem;
    line-height: 1.5;
    max-width: 30ch;
  }
  .menu__icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--mint);
  }
  .menu__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    color: var(--offwhite);
  }
</style>
