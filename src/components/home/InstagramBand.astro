---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { instagramMedia } from '../../data/instagram';
import { site } from '../../data/site';

const handle = site.instagram.handle;
const repeats = Array.from({ length: 4 });
/*
 * Roleta: a lista é renderizada duas vezes (a segunda cópia é decorativa,
 * fora da ordem de foco e oculta de leitores de tela). Deslocar a faixa em
 * -50% devolve exatamente a posição inicial — laço sem emenda.
 */
const loop = [...instagramMedia, ...instagramMedia];
---

<section class="insta" aria-labelledby="insta-title" data-insta>
  <h2 id="insta-title" class="sr-only">Instagram {handle}</h2>

  <a class="insta__marquee" href={site.instagram.url} target="_blank" rel="noopener">
    <span class="sr-only">Seguir {handle} no Instagram</span>
    <span class="insta__handle" data-marquee data-marquee-sets="4" data-marquee-duration="34" aria-hidden="true">
      {
        repeats.map(() => (
          <span class="insta__chunk">
            <span class="insta__word">{handle}</span>
            <Icon name="sparkle" class="insta__star" />
          </span>
        ))
      }
    </span>
  </a>

  {
    instagramMedia.length > 0 && (
      <div class="insta__roleta" data-marquee-host>
        <ul
          class="insta__track"
          role="list"
          data-marquee
          data-marquee-sets="2"
          data-marquee-dir="-1"
          data-marquee-duration="48"
          data-marquee-hover-pause
        >
          {loop.map((m, i) => {
            const clone = i >= instagramMedia.length;
            return (
              <li class:list={['insta__item', { 'insta__item--clone': clone }]} aria-hidden={clone ? 'true' : undefined}>
                <a
                  href={site.instagram.url}
                  target="_blank"
                  rel="noopener"
                  class="insta__link"
                  tabindex={clone ? -1 : undefined}
                  aria-label={clone ? undefined : `${m.alt} — ver no Instagram`}
                >
                  {m.type === 'video' && m.video ? (
                    <video class="insta__video" muted loop playsinline preload="none" data-autoplay-in-view aria-hidden="true">
                      <source src={m.video} type="video/mp4" />
                    </video>
                  ) : null}
                  <Picture
                    src={m.image}
                    alt=""
                    widths={[360, 540, 720].filter((w) => w <= m.image.width)}
                    sizes="(max-width: 700px) 56vw, 19rem"
                    formats={['avif', 'webp']}
                    class="insta__img"
                    loading="lazy"
                  />
                  {m.type === 'video' && (
                    <span class="insta__badge" aria-hidden="true">
                      Reels
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  <div class="insta__foot container" data-reveal>
    <p>Bastidores, cuidados e novidades do consultório.</p>
    <Button href={site.instagram.url} label="Seguir no Instagram" variant="ghost" icon="instagram" iconFirst size="sm" />
  </div>
</section>

<style>
  .insta {
    position: relative;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    overflow: clip;
  }

  /* ---------- Letreiro do @ ---------- */
  .insta__marquee {
    display: block;
    overflow: hidden;
    white-space: nowrap;
  }
  .insta__handle {
    display: inline-flex;
    will-change: transform;
  }
  .insta__chunk {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
    padding-right: clamp(1.25rem, 2.5vw, 2.75rem);
  }
  .insta__word {
    font-family: var(--serif);
    font-weight: 330;
    font-style: italic;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 6.5rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--petrol);
  }
  .insta__star {
    width: clamp(1.3rem, 2.4vw, 2.4rem);
    height: clamp(1.3rem, 2.4vw, 2.4rem);
    color: var(--petrol);
    stroke-width: 1;
  }

  /* ---------- Roleta de fotos ---------- */
  .insta__roleta {
    position: relative;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    overflow: hidden;
  }
  /* Esmaecimento nas bordas: camadas estáticas (mais leve que mask-image). */
  .insta__roleta::before,
  .insta__roleta::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: clamp(1.5rem, 6vw, 6rem);
    pointer-events: none;
  }
  .insta__roleta::before {
    left: 0;
    background: linear-gradient(90deg, var(--offwhite), rgba(251, 249, 241, 0));
  }
  .insta__roleta::after {
    right: 0;
    background: linear-gradient(270deg, var(--offwhite), rgba(251, 249, 241, 0));
  }
  .insta__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    will-change: transform;
  }
  .insta__item {
    flex: none;
    /* padding (e não gap): cada cópia tem exatamente a mesma largura */
    width: clamp(11.5rem, 19vw, 19rem);
    padding-right: clamp(0.7rem, 1.2vw, 1.1rem);
    box-sizing: content-box;
  }
  .insta__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--gray-soft);
    transform: translateZ(0);
  }
  .insta__link :global(picture),
  .insta__link :global(.insta__img),
  .insta__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .insta__link :global(.insta__img),
  .insta__video {
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  .insta__video {
    z-index: 1;
    opacity: 0;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1.1s var(--ease-out);
  }
  :global(.insta__video.is-playing) {
    opacity: 1;
  }
  @media (hover: hover) {
    .insta__link:hover :global(.insta__img),
    .insta__link:hover .insta__video {
      transform: scale(1.04);
    }
  }
  .insta__badge {
    position: absolute;
    left: 0.8rem;
    top: 0.8rem;
    z-index: 2;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(251, 249, 241, 0.9);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Sem animação (movimento reduzido ou sem JS): faixa rolável, sem barra visível. */
  :global(html:not(.motion)) .insta__roleta {
    overflow-x: auto;
    scrollbar-width: none;
    padding-left: var(--gutter);
  }
  :global(html:not(.motion)) .insta__roleta::-webkit-scrollbar {
    display: none;
  }
  :global(html:not(.motion)) .insta__item--clone {
    display: none;
  }

  .insta__foot {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-2);
  }
</style>
