---
import Button from '../Button.astro';
import { whatsapp } from '../../data/site';

const steps = [
  {
    title: 'Avaliação individual',
    text: 'Um encontro dedicado a conhecer você: sua história, sua pele, suas expectativas e o que deseja preservar.',
    icon: 'M12 12.5a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Zm-6.5 7c.8-3.6 3.4-5.6 6.5-5.6s5.7 2 6.5 5.6',
  },
  {
    title: 'Análise das necessidades',
    text: 'Uma leitura cuidadosa das características do rosto e da pele para entender o que realmente faz sentido.',
    icon: 'M10.5 16.5a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm4.3-1.7 4.7 4.7M7.8 10.5h5.4',
  },
  {
    title: 'Planejamento personalizado',
    text: 'Um plano construído por etapas, com prioridades claras e no tempo adequado para você.',
    icon: 'M5 5.5h14M5 10h9M5 14.5h11M5 19h6',
  },
  {
    title: 'Realização dos procedimentos indicados',
    text: 'Execução precisa, com conforto e segurança, apenas do que foi indicado no seu planejamento.',
    icon: 'M12 3.5c.6 4.4 2.6 6.4 7 7-4.4.6-6.4 2.6-7 7-.6-4.4-2.6-6.4-7-7 4.4-.6 6.4-2.6 7-7Z',
  },
  {
    title: 'Acompanhamento da evolução',
    text: 'Retornos e ajustes ao longo do processo, respeitando o tempo de resposta de cada organismo.',
    icon: 'M3.5 17.5 9 12l3.5 3.5 8-8M15 7.5h5.5V13',
  },
];
---

<section class="process bg-mint" id="atendimento" aria-labelledby="process-title" data-process>
  <div class="process__pin" data-process-pin>
    <div class="process__viewport">
      <div class="process__track" data-process-track>
        <div class="process__intro">
          <p class="eyebrow" data-reveal>Como funciona o atendimento</p>
          <h2 id="process-title" class="h1 process__title" data-split>
            Um caminho <em>sem pressa</em>, do primeiro encontro ao acompanhamento.
          </h2>
          <p class="lead process__lead" data-reveal>
            Cinco etapas para que cada decisão seja tomada com clareza, no seu tempo.
          </p>
          <p class="process__hint" aria-hidden="true">
            <span class="process__hint-line"></span> Continue rolando
          </p>
        </div>

        <ol class="process__steps" role="list">
          {
            steps.map((s, i) => (
              <li class="pstep" data-pstep>
                <div class="pstep__top">
                  <span class="pstep__num" aria-hidden="true" data-pstep-num>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <svg class="pstep__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={s.icon} data-pstep-icon />
                  </svg>
                </div>
                <div class="pstep__body" data-pstep-body>
                  <p class="pstep__label">Etapa {i + 1} de {steps.length}</p>
                  <h3 class="pstep__title">{s.title}</h3>
                  <p class="pstep__text">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="process__end">
          <p class="process__end-title">O primeiro passo começa com uma <em>conversa.</em></p>
          <Button href={whatsapp()} label="Agende sua avaliação" icon="whatsapp" iconFirst />
        </div>
      </div>
    </div>
    <div class="process__progress container" aria-hidden="true">
      <div class="process__bar"><span data-process-progress></span></div>
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    overflow: clip;
  }
  .process__pin {
    position: relative;
    padding-block: var(--section);
  }
  .process__viewport {
    overflow: visible;
  }
  .process__track {
    display: grid;
    gap: 3rem;
    padding-inline: var(--gutter);
    max-width: var(--max);
    margin-inline: auto;
  }
  .process__title {
    margin-top: 1.4rem;
    max-width: 13ch;
    min-width: min-content;
    font-size: clamp(2.3rem, 1.3rem + 3.3vw, 4.9rem);
  }
  @media (max-width: 1023px) {
    .process__title {
      max-width: none;
    }
  }
  .process__lead {
    margin-top: 1.6rem;
    max-width: 36ch;
    color: var(--ink);
  }
  .process__hint {
    display: none;
  }
  .process__steps {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    counter-reset: step;
  }
  .pstep {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.4rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(47, 62, 60, 0.2);
  }
  .pstep__top {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }
  .pstep__num {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3.4rem, 2.6rem + 3vw, 5.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--petrol);
  }
  .pstep__icon {
    width: 1.9rem;
    height: 1.9rem;
    fill: none;
    stroke: var(--petrol);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pstep__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--petrol);
  }
  .pstep__title {
    margin-top: 0.7rem;
    font-family: var(--serif);
    font-weight: 430;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .pstep__text {
    margin-top: 0.9rem;
    max-width: 36ch;
    color: var(--ink);
    opacity: 0.85;
  }
  .process__end {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
    padding-top: 2rem;
    border-top: 1px solid rgba(47, 62, 60, 0.2);
  }
  .process__end-title {
    font-family: var(--serif);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .process__progress {
    display: none;
  }

  /* ---------- Desktop: jornada horizontal fixada ---------- */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(html.motion) .process__pin {
      height: 100vh;
      padding-block: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    :global(html.motion) .process__viewport {
      overflow: hidden;
    }
    :global(html.motion) .process__track {
      display: flex;
      align-items: stretch;
      gap: 0;
      width: max-content;
      max-width: none;
      margin: 0;
      padding-left: var(--gutter);
      padding-right: 12vw;
      will-change: transform;
    }
    :global(html.motion) .process__intro {
      width: min(46vw, 44rem);
      flex: none;
      padding-right: 6vw;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    :global(html.motion) .process__hint {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      margin-top: 2.6rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    :global(html.motion) .process__hint-line {
      width: 3rem;
      height: 1px;
      background: currentColor;
    }
    :global(html.motion) .process__steps {
      display: flex;
    }
    :global(html.motion) .pstep {
      width: min(31vw, 30rem);
      flex: none;
      grid-template-columns: 1fr;
      align-content: start;
      gap: 2.2rem;
      padding: 0 3vw 0 2.2vw;
      border-top: 0;
      border-left: 1px solid rgba(47, 62, 60, 0.22);
      min-height: 62vh;
    }
    :global(html.motion) .pstep__top {
      grid-auto-flow: column;
      justify-content: space-between;
      align-items: end;
      width: 100%;
    }
    :global(html.motion) .pstep__num {
      font-size: clamp(6rem, 9vw, 10rem);
    }
    :global(html.motion) .process__end {
      width: min(34vw, 30rem);
      flex: none;
      align-content: center;
      padding: 0 0 0 3vw;
      border-top: 0;
      border-left: 1px solid rgba(47, 62, 60, 0.22);
    }
    :global(html.motion) .process__progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 6vh;
    }
    :global(html.motion) .process__bar {
      height: 1px;
      background: rgba(47, 62, 60, 0.18);
    }
    :global(html.motion) .process__bar span {
      display: block;
      height: 100%;
      background: var(--petrol);
      transform-origin: left;
      transform: scaleX(0);
    }
  }
</style>
