---
import Button from '../Button.astro';
import { whatsapp } from '../../data/site';

const steps = [
  {
    title: 'Avaliação individual',
    text: 'Conhecer você: sua história, sua pele e suas expectativas.',
    icon: 'M12 12.5a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Zm-6.5 7c.8-3.6 3.4-5.6 6.5-5.6s5.7 2 6.5 5.6',
  },
  {
    title: 'Análise das necessidades',
    text: 'Uma leitura cuidadosa do rosto e da pele.',
    icon: 'M10.5 16.5a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm4.3-1.7 4.7 4.7M7.8 10.5h5.4',
  },
  {
    title: 'Planejamento personalizado',
    text: 'Um plano por etapas, no seu tempo.',
    icon: 'M5 5.5h14M5 10h9M5 14.5h11M5 19h6',
  },
  {
    title: 'Procedimentos indicados',
    text: 'Apenas o que foi planejado, com precisão e conforto.',
    icon: 'M12 3.5c.6 4.4 2.6 6.4 7 7-4.4.6-6.4 2.6-7 7-.6-4.4-2.6-6.4-7-7 4.4-.6 6.4-2.6 7-7Z',
  },
  {
    title: 'Acompanhamento',
    text: 'Retornos e ajustes ao longo da evolução.',
    icon: 'M3.5 17.5 9 12l3.5 3.5 8-8M15 7.5h5.5V13',
  },
];
---

<section class="process section bg-mint" id="atendimento" aria-labelledby="process-title" data-process>
  <div class="container">
    <header class="process__head">
      <div>
        <p class="eyebrow" data-reveal>Como funciona o atendimento</p>
        <h2 id="process-title" class="h2 process__title" data-split>
          Um caminho <em>sem pressa.</em>
        </h2>
      </div>
      <div class="process__side" data-reveal>
        <p class="process__lead">Cinco etapas para que cada decisão seja tomada com clareza, no seu tempo.</p>
        <Button href={whatsapp()} label="Agende sua avaliação" icon="whatsapp" iconFirst size="sm" />
      </div>
    </header>

    <div class="process__rail" aria-hidden="true"><span data-process-line></span></div>

    <ol class="process__steps" role="list" data-reveal-children>
      {
        steps.map((s, i) => (
          <li class="pstep">
            <div class="pstep__top">
              <span class="pstep__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <svg class="pstep__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={s.icon} data-pstep-icon />
              </svg>
            </div>
            <h3 class="pstep__title">{s.title}</h3>
            <p class="pstep__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .process__title {
    margin-top: 1.2rem;
  }
  .process__side {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-bottom: 0.4rem;
  }
  .process__lead {
    color: var(--ink);
    opacity: 0.85;
    max-width: 40ch;
  }

  .process__rail {
    position: relative;
    height: 1px;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: rgba(47, 62, 60, 0.18);
  }
  .process__rail span {
    position: absolute;
    inset: 0;
    background: var(--petrol);
    transform-origin: left;
  }

  .process__steps {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }
  .pstep {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1.6rem;
  }
  .pstep__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .pstep__num {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 1.9rem + 2vw, 3.8rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--petrol);
  }
  .pstep__icon {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: var(--petrol);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pstep__title {
    margin-top: 0.6rem;
    font-family: var(--serif);
    font-weight: 450;
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .pstep__text {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink);
    opacity: 0.82;
  }

  @media (max-width: 1024px) {
    .process__head {
      grid-template-columns: 1fr;
    }
    .process__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 1.5rem;
    }
  }
  @media (max-width: 640px) {
    .process__rail {
      display: none;
    }
    .process__steps {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 1.5rem;
    }
    .pstep {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1.1rem;
      padding: 1.1rem 0;
      border-top: 1px solid rgba(47, 62, 60, 0.18);
    }
    .pstep__top {
      grid-row: 1 / span 2;
      flex-direction: column;
      align-items: flex-start;
    }
    .pstep__num {
      font-size: 2.4rem;
    }
    .pstep__title {
      margin-top: 0;
    }
  }
</style>
