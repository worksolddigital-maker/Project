{
  "name": "trading-desk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:build": "tsx --conditions=react-server scripts/market-snapshot.ts demo/market-snapshot.json && vite build --config demo/vite.config.ts && node scripts/demo-artifact.mjs",
    "market:snapshot": "tsx --conditions=react-server scripts/market-snapshot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.108.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "geist": "^1.9.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.7",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
